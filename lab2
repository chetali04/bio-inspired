import random
import math

def objective_function(x):
    """The problem we want to solve: Minimize the sphere function.
    The absolute best solution is at x = 0 where the result is 0."""
    return sum(val ** 2 for val in x)

def bio_inspired_sudden_solver(dimensions, num_agents, max_iter):
    # 1. Initialize random starting positions (Prey/Solutions)
    agents = [[random.uniform(-10, 10) for _ in range(dimensions)] for _ in range(num_agents)]
    
    # Track the absolute best biological solution found so far (the target)
    best_solution = min(agents, key=objective_function)
    best_fitness = objective_function(best_solution)

    print(f"Initial best guess score: {best_fitness:.4f}")

    # 2. Main Optimization Loop
    for iteration in range(max_iter):
        # Linearly decreasing energy of the prey over time (Nature's timer)
        prey_energy = 2 * (1 - (iteration / max_iter))

        for i in range(num_agents):
            # Calculate a sudden jump factor using a simulated random walk (Lévy Flight)
            jump_strength = 2 * (1 - random.random())
            
            # --- THE "SUDDEN SOLUTION" / SURPRISE POUNCE MECHANISM ---
            if prey_energy < 0.5:
                # Rapid Dive: The agent suddenly and aggressively attacks the best known solution
                for d in range(dimensions):
                    agents[i][d] = best_solution[d] - prey_energy * abs(jump_strength * best_solution[d] - agents[i][d])
            else:
                # Standard Exploration: Roaming around looking for general paths
                for d in range(dimensions):
                    agents[i][d] = agents[i][d] + random.uniform(-1, 1) * prey_energy

            # 3. Bound checking (keep values within reasonable limits)
            agents[i] = [max(min(val, 10), -10) for val in agents[i]]

            # 4. Update the global best solution if a better one is found
            current_fitness = objective_function(agents[i])
            if current_fitness < best_fitness:
                best_fitness = current_fitness
                best_solution = agents[i][:]

    return best_solution, best_fitness

# --- Example Usage ---
best_pos, best_score = bio_inspired_sudden_solver(dimensions=3, num_agents=20, max_iter=100)

print("\n===============================")
print(f"Sudden Optimization Complete!")
print(f"Best Coordinates Found: {[round(p, 4) for p in best_pos]}")
print(f"Best Solution Score: {best_score:.6f} (Targeting 0.0)")
print("===============================")
