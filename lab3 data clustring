mport numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. GENERATE SYNTHETIC DATA
# ==========================================
np.random.seed(42)
# Create 3 distinct clusters in a 2D plane (True centers around (0,0), (3,3), and (6,6))
X = np.vstack([
    np.random.normal(loc=0.0, scale=0.4, size=(30, 2)),
    np.random.normal(loc=3.0, scale=0.4, size=(30, 2)),
    np.random.normal(loc=6.0, scale=0.4, size=(30, 2))
])

# ==========================================
# 2. FITNESS FUNCTION (SUM OF SQUARED ERRORS)
# ==========================================
def compute_sse(centroids_flat, data, K):
    """
    Calculates the Total Sum of Squared Errors (SSE).
    """
    dim = data.shape[1]
    centroids = centroids_flat.reshape(K, dim)
    
    # Calculate Euclidean distances from all points to all centroids
    distances = np.linalg.norm(data[:, np.newaxis, :] - centroids[np.newaxis, :, :], axis=2)
    
    # Square the distances to the closest centroid and sum them up
    min_squared_distances = np.min(distances, axis=1) ** 2
    return np.sum(min_squared_distances)

def get_cluster_labels(centroids, data):
    """
    Assigns each data point to its nearest centroid index.
    """
    distances = np.linalg.norm(data[:, np.newaxis, :] - centroids[np.newaxis, :, :], axis=2)
    return np.argmin(distances, axis=1)

# ==========================================
# 3. PSO CLUSTERING ALGORITHM CLASSES
# ==========================================
class Particle:
    def __init__(self, data, K):
        self.dim = data.shape[1]
        self.K = K
        self.particle_dim = K * self.dim
        
        # Initialize centroids randomly within the spatial bounds of the data
        min_bounds = data.min(axis=0)
        max_bounds = data.max(axis=0)
        
        random_centroids = np.array([
            np.random.uniform(min_bounds[d], max_bounds[d], K) 
            for d in range(self.dim)
        ]).T
        
        self.position = random_centroids.flatten()
        self.velocity = np.zeros(self.particle_dim)
        
        # Track individual memory records
        self.pbest_position = self.position.copy()
        self.pbest_fitness = float('inf')

    def update_position(self):
        self.position += self.velocity


class PSOClusterer:
    def __init__(self, data, K, n_particles=30, w=0.7, c1=1.5, c2=1.5):
        self.data = data
        self.K = K
        self.n_particles = n_particles
        self.w = w    # Inertia weight
        self.c1 = c1  # Cognitive coefficient (individual pull)
        self.c2 = c2  # Social coefficient (swarm leader pull)
        
        # Initialize the group of particles
        self.particles = [Particle(data, K) for _ in range(n_particles)]
        
        # Global swarm leadership records
        self.gbest_position = None
        self.gbest_fitness = float('inf')
        
    def fit(self, max_iter=100):
        # Initial evaluation of random points
        for particle in self.particles:
            fitness = compute_sse(particle.position, self.data, self.K)
            particle.pbest_fitness = fitness
            
            if fitness < self.gbest_fitness:
                self.gbest_fitness = fitness
                self.gbest_position = particle.position.copy()
                
        # Main optimization loop
        for it in range(max_iter):
            for particle in self.particles:
                r1 = np.random.rand(particle.particle_dim)
                r2 = np.random.rand(particle.particle_dim)
                
                # Standard Velocity adjustment formula
                cognitive = self.c1 * r1 * (particle.pbest_position - particle.position)
                social = self.c2 * r2 * (self.gbest_position - particle.position)
                particle.velocity = (self.w * particle.velocity) + cognitive + social
                
                # Apply position adjustment
                particle.update_position()
                
                # Check performance
                current_fitness = compute_sse(particle.position, self.data, self.K)
                
                # Update Personal Best memory
                if current_fitness < particle.pbest_fitness:
                    particle.pbest_fitness = current_fitness
                    particle.pbest_position = particle.position.copy()
                    
                    # Update Swarm Global Best leader
                    if current_fitness < self.gbest_fitness:
                        self.gbest_fitness = current_fitness
                        self.gbest_position = particle.position.copy()
            
            if (it + 1) % 20 == 0 or it == 0:
                print(f"Iteration {it+1:03d}/{max_iter} -> Swarm Minimum SSE: {self.gbest_fitness:.4f}")
                
        # Reconstruct flattened coordinates back into a usable Matrix
        optimal_centroids = self.gbest_position.reshape(self.K, self.data.shape[1])
        return optimal_centroids

# ==========================================
# 4. EXECUTION AND VISUALIZATION
# ==========================================
if __name__ == "__main__":
    K_clusters = 3
    print(f"Starting PSO Clustering on {X.shape[0]} samples...")
    
    # Initialize and execute the PSO trainer
    pso = PSOClusterer(data=X, K=K_clusters, n_particles=40, w=0.5, c1=1.5, c2=1.5)
    final_centroids = pso.fit(max_iter=100)
    
    print("\nFinal Centroids Discovered:\n", final_centroids)
    
    # Assign data points to their closest discovered center
    labels = get_cluster_labels(final_centroids, X)
    
    # Plotting results
    plt.figure(figsize=(8, 6))
    
    # Plot data points colored by their assigned cluster
    colors = ['crimson', 'dodgerblue', 'mediumseagreen']
    for k in range(K_clusters):
        cluster_data = X[labels == k]
        plt.scatter(cluster_data[:, 0], cluster_data[:, 1], c=colors[k], label=f'Cluster {k+1}', alpha=0.7, edgecolors='k')
    
    # Plot the final discovered centroids
    plt.scatter(final_centroids[:, 0], final_centroids[:, 1], c='gold', marker='*', s=250, 
                edgecolors='black', linewidths=1.5, label='PSO Centroids')
    
    plt.title('Data Clustering Results using Particle Swarm Optimization', fontsize=12)
    plt.xlabel('X Coordinate')
    plt.ylabel('Y Coordinate')
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.legend()
    plt.show()
