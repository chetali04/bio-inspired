def is_valid(board, row, col, num):
    """Checks if it is legal to place 'num' at board[row][col]"""
    # 1. Check the row
    for x in range(9):
        if board[row][x] == num:
            return False

    # 2. Check the column
    for x in range(9):
        if board[x][col] == num:
            return False

    # 3. Check the 3x3 sub-grid
    start_row = row - row % 3
    start_col = col - col % 3
    for i in range(3):
        for j in range(3):
            if board[i + start_row][j + start_col] == num:
                return False
                
    return True

def solve_sudoku(board):
    """Solves the Sudoku board using a backtracking algorithm"""
    for row in range(9):
        for col in range(9):
            # Find an empty cell (represented by 0)
            if board[row][col] == 0:
                for num in range(1, 10):
                    if is_valid(board, row, col, num):
                        board[row][col] = num  # Tentatively place the number
                        
                        # Recursively try to solve the rest of the board
                        if solve_sudoku(board):
                            return True
                        
                        board[row][col] = 0  # Undo choice (backtrack)
                        
                return False  # Trigger backtracking if no number fits
    return True  # Board is fully and correctly filled

def print_board(board):
    """Helper function to print the grid with standard Sudoku lines"""
    for i in range(9):
        if i % 3 == 0 and i != 0:
            print("- - - - - - - - - - - -")
        for j in range(9):
            if j % 3 == 0 and j != 0:
                print(" | ", end="")
            print(board[i][j], end=" ")
        print()

# --- Example Puzzle Grid (0 represents empty cells) ---
puzzle = [
    [5, 3, 0, 0, 7, 0, 0, 0, 0],
    [6, 0, 0, 1, 9, 5, 0, 0, 0],
    [0, 9, 8, 0, 0, 0, 0, 6, 0],
    [8, 0, 0, 0, 6, 0, 0, 0, 3],
    [4, 0, 0, 8, 0, 3, 0, 0, 1],
    [7, 0, 0, 0, 2, 0, 0, 0, 6],
    [0, 6, 0, 0, 0, 0, 2, 8, 0],
    [0, 0, 0, 4, 1, 9, 0, 0, 5],
    [0, 0, 0, 0, 8, 0, 0, 7, 9]
]

print("Original Puzzle:")
print_board(puzzle)
print("\n" + "="*24 + "\n")

if solve_sudoku(puzzle):
    print("Solved Puzzle:")
    print_board(puzzle)
else:
    print("No solution exists for this puzzle.")
